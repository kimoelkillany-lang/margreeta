rules_version = '2';

// Margreeta POS: Firestore security rules.
// Paste this whole file into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff accounts allowed to use the POS. To add a person, add their login email to the list,
    // e.g. ['staff@margreeta.com', 'karim@margreeta.com'], then Publish again.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['staff@margreeta.com'];
    }

    // One document per order.
    match /orders/{orderId} {
      allow read, write: if isStaff();
    }

    // menu/state holds the sold-out list.
    match /menu/{docId} {
      allow read, write: if isStaff();
    }

    // Anything else is closed. Nobody can read or write it from the app or the website.
  }
}
